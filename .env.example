# Copy to .env and fill in. Never commit .env.
# Used from Phase 4 (FFmpeg streaming) onwards.
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=

# Kick (run_bot.py --kick). Both from kick.com > Creator Dashboard > Settings > Stream Key
KICK_STREAM_URL=
KICK_STREAM_KEY=
# landscape (default: game centred in 1920x1080, what Kick's player expects) or portrait
KICK_LAYOUT=landscape
# Lower this (e.g. 2500k) if Kick shows UNSTABLE; raise it (max ~6000k) on a fast upload
KICK_BITRATE=3500k

# Twitch (run_bot.py --twitch). twitch.tv > Creator Dashboard > Settings > Stream > Primary Stream key
TWITCH_STREAM_KEY=
# TWITCH_STREAM_URL=rtmp://live.twitch.tv/app   (default; TWITCH_LAYOUT / TWITCH_BITRATE work like Kick's)

# Facebook Live (run_bot.py --facebook). facebook.com > Live Producer > Streaming software > Stream key
FACEBOOK_STREAM_KEY=
# FACEBOOK_STREAM_URL=rtmps://live-api-s.facebook.com:443/rtmp   (default; FACEBOOK_LAYOUT / FACEBOOK_BITRATE work like Kick's)

# Several platforms together (--kick --twitch --facebook, layouts must match) (--kick --twitch): one encode, uploaded twice. Upload needed = 2 x this
MULTI_STREAM_BITRATE=1800k

# Optional overrides
LOG_LEVEL=INFO
